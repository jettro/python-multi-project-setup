# Copying this file is not sufficient: run `make pypi-init-auth` instead.
# The generated local-pypi/.env and auth/htpasswd files are ignored by Git.
UV_INDEX_LOCAL_USERNAME=local
UV_INDEX_LOCAL_PASSWORD=replace-with-a-generated-local-password
UV_PUBLISH_USERNAME=local
UV_PUBLISH_PASSWORD=replace-with-the-same-generated-local-password
